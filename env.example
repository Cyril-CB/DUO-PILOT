# Local personal prototype. AI subscriptions are used through the official CLIs.
# Authenticate each CLI yourself on this machine. No AI API key here.
USE_SUBSCRIPTION_CLI=false
CODEX_BIN=codex
CLAUDE_BIN=claude
CODEX_MODEL=
CLAUDE_MODEL=
CLI_TIMEOUT=180

# owner/repository, without https://github.com/
CSPILOT_REPO=
CSPILOT_BASE_BRANCH=dev
SELF_REPO=
SELF_BASE_BRANCH=main
# Optional for public repos; fine-grained read-only token for private repos.
GITHUB_TOKEN=

# Optional persistent random session secret, useful between server restarts.
SECRET_KEY=
